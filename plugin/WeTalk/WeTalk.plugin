#!name=WeTalk (支持 BoxJS 账号管理)
#!desc=WeTalk 自动化签到+视频奖励，多账号库可在 BoxJS → WeTalk 中查看/删除\n原插件: cloudsonly/Loon plugin/WeTalk
#!author= ZenMoFiShi (BoxJS 适配 by Minis)
#!icon=https://raw.githubusercontent.com/Xhy333/QuantumultX/main/icon/WeTalk.png
#!date = 2026-11-04 06:00:00

[Script]
http-request ^https:\/\/api\.wetalkapp\.com\/app\/queryBalanceAndBonus script-path=https://raw.githubusercontent.com/[你的用户名]/[仓库]/main/WeTalk.js, tag=WeTalk

cron "20 0,8,16 * * *" script-path=https://raw.githubusercontent.com/[你的用户名]/[仓库]/main/WeTalk.js, timeout=120, tag=WeTalk签到

[MITM]
hostname = api.wetalkapp.com