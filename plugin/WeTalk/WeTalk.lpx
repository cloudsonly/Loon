#!name=WeTalk
#!desc=WeTalk 自动化签到+视频奖励（kufei326 原脚本 + 新版语法）\n抓包开关：抓到账号后关掉，Loon 就不再解密和解析该请求
#!author= ZenMoFeiShi[https://github.com/ZenmoFeiShi?tab=repositories]
#!homepage=https://github.com/cloudsonly/Loon
#!icon=https://raw.githubusercontent.com/Xhy333/QuantumultX/main/icon/WeTalk.png
#!loon_version=3.5.1(983)
#!date = 2026-11-04 18:20:00
#!tag=签到

[Argument]
capture = switch,true,tag=抓包（抓到账号后关掉）,desc=打开时解析 queryBalanceAndBonus 并把账号写入账号库；关闭后这条规则整条不命中

[Script]
request if ${capture} == true && ${url} ~= /^https:\/\/api\.wetalkapp\.com\/app\/queryBalanceAndBonus/i then script("https://raw.githubusercontent.com/cloudsonly/Loon/refs/heads/main/plugin/WeTalk/WeTalk.lpx.js") with tag="WeTalk抓包", requires_body=true

cron "20 0,8,16 * * *" then script("https://raw.githubusercontent.com/cloudsonly/Loon/refs/heads/main/plugin/WeTalk/WeTalk.lpx.js") with tag="WeTalk签到", timeout=120

[MITM]
hostname = api.wetalkapp.com