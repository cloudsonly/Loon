{
  "id": "cloudsonly.wetalk",
  "name": "WeTalk",
  "author": "@ZenMoFiShi",
  "icon": "https://raw.githubusercontent.com/Xhy333/QuantumultX/main/icon/WeTalk.png",
  "repo": "https://github.com/cloudsonly/Loon",
  "apps": [
    {
      "id": "WeTalk",
      "name": "WeTalk 多账号",
      "keys": [
        "wetalk_accounts_v1",
        "WeTalk.delKeys",
        "WeTalk.accountList",
        "WeTalk.accountListText",
        "WeTalk.accountRaw",
        "WeTalk.clearAll",
        "WeTalk.resetToken"
      ],
      "settings": [
        {
          "id": "@WeTalk.clearAll",
          "name": "① 清空全部账号",
          "val": false,
          "type": "boolean",
          "desc": "开启后点下方 ③ 的 ▶ 立即清空（或打开一次 WeTalk App 触发）；完成后自动复位为关闭，重新抓包即可"
        },
        {
          "id": "@WeTalk.accountList",
          "name": "② 已存账号（勾选＝标记删除）",
          "val": "（账号库为空）",
          "type": "checkboxes",
          "desc": "要删哪个就勾哪个，然后点右上角「保存」，再点下方 ③ 的 ▶ 立即删除；☑ 标记已勾选待删除。删掉的账号如再抓包会重新加入",
          "items": []
        },
        {
          "id": "@WeTalk.accountRaw",
          "name": "账号库原文",
          "val": "",
          "type": "textarea",
          "rows": 12,
          "autoGrow": true,
          "persistentHint": true,
          "desc": "点下方脚本「查看账号库原文」▶ 后自动写入；只读参考，不要手改"
        },
        {
          "id": "@WeTalk.resetToken",
          "name": "上次清理结果",
          "val": "",
          "type": "textarea",
          "rows": 4,
          "autoGrow": true,
          "persistentHint": true,
          "desc": "每次清理完成后自动写入，用来确认真的删掉了（例如「🗑 已删除 2 个账号，剩余 1 个」）"
        }
      ],
      "author": "@ZenMoFiShi",
      "repo": "https://github.com/cloudsonly/Loon/tree/main/plugin/WeTalk",
      "script": "https://raw.githubusercontent.com/cloudsonly/Loon/refs/heads/main/plugin/WeTalk/WeTalk.js",
      "scripts": [
        {
          "name": "③ 执行清理（勾选/清空后点这里）",
          "script": "https://raw.githubusercontent.com/cloudsonly/Loon/refs/heads/main/plugin/WeTalk/WeTalk.manage.js"
        },
        {
          "name": "④ 查看账号库原文",
          "script": "https://raw.githubusercontent.com/cloudsonly/Loon/refs/heads/main/plugin/WeTalk/WeTalk.list.js"
        }
      ],
      "icons": [
        "https://raw.githubusercontent.com/Xhy333/QuantumultX/main/icon/WeTalk.png",
        "https://raw.githubusercontent.com/Xhy333/QuantumultX/main/icon/WeTalk.png"
      ]
    }
  ]
}