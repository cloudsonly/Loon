{
  "id": "cloudsonly.wetalk",
  "name": "WeTalk",
  "author": "@ZenMoFiShi",
  "icon": "https://raw.githubusercontent.com/Xhy333/QuantumultX/main/icon/WeTalk.png",
  "repo": "https://github.com/cloudsonly/Loon",
  "apps": [
    {
      "id": "WeTalk",
      "name": "WeTalk 多账号",
      "keys": [
        "wetalk_accounts_v1",
        "WeTalk.clearAll"
      ],
      "settings": [
        {
          "id": "@WeTalk.clearAll",
          "name": "清空全部账号",
          "val": false,
          "type": "boolean",
          "desc": "打开后点右上角 ▶ 执行一次即清空全部账号，完成后自动复位为关闭；之后重新抓包"
        }
      ],
      "author": "@ZenMoFiShi",
      "repo": "https://github.com/cloudsonly/Loon/tree/main/plugin/WeTalk",
      "script": "https://raw.githubusercontent.com/cloudsonly/Loon/refs/heads/main/plugin/WeTalk/WeTalk.js",
      "scripts": [
        {
          "name": "① 删除指定的账号（填序号，可多个）",
          "script": "https://raw.githubusercontent.com/cloudsonly/Loon/refs/heads/main/plugin/WeTalk/WeTalk.del.js?index=1"
        },
        {
          "name": "② 删除全部账号（先在上面打开开关）",
          "script": "https://raw.githubusercontent.com/cloudsonly/Loon/refs/heads/main/plugin/WeTalk/WeTalk.del.js?all=1"
        },
        {
          "name": "③ 只看账号列表（不改动）",
          "script": "https://raw.githubusercontent.com/cloudsonly/Loon/refs/heads/main/plugin/WeTalk/WeTalk.del.js"
        }
      ],
      "icons": [
        "https://raw.githubusercontent.com/Xhy333/QuantumultX/main/icon/WeTalk.png",
        "https://raw.githubusercontent.com/Xhy333/QuantumultX/main/icon/WeTalk.png"
      ]
    }
  ]
}