{
  "id": "kufei326.wetalk.sub",
  "name": "WeTalk 通用订阅",
  "author": "@ZenMoFiShi",
  "icon": "https://raw.githubusercontent.com/Orz-3/mini/master/Color/box.png",
  "repo": "https://github.com/kufei326/surge",
  "apps": [
    {
      "id": "WeTalk",
      "name": "WeTalk 自动化签到",
      "keys": [],
      "settings": [
        {
          "id": "@WeTalk.accountList",
          "name": "当前已存账号（只读）",
          "val": "（空）",
          "type": "textarea",
          "rows": 10,
          "autoGrow": true,
          "persistentHint": true,
          "desc": "每次抓包或执行清理后自动刷新。序号就是下面要删除的序号"
        },
        {
          "id": "@WeTalk.pruneMode",
          "name": "清理动作",
          "val": "off",
          "type": "selects",
          "items": [
            { "key": "off", "label": "off（不做任何清理）" },
            { "key": "delete", "label": "delete（删除下方序号对应账号）" },
            { "key": "reset", "label": "reset（清空全部账号重新抓包）" }
          ],
          "desc": "选好后，打开一次 WeTalk App 触发抓包即生效；生效后会自动变回 off"
        },
        {
          "id": "@WeTalk.delIndexes",
          "name": "要删除的账号序号",
          "val": "1",
          "type": "text",
          "placeholder": "例: 2,3,5  或  2 3 5",
          "desc": "对应上面列表的序号（从 1 开始），留空表示不删除。脚本会自动填上建议保留位"
        }
      ],
      "author": "@ZenMoFiShi / Minis",
      "repo": "https://github.com/kufei326/surge/blob/main/WeTalk.js",
      "script": "https://raw.githubusercontent.com/kufei326/surge/main/WetTalk.js",
      "icons": []
    }
  ]
}